docs/emass/CMMC_Level2_AssessmentResults_Template.xlsx

# Extra files dropped next to the committed Scoping mark (Admin demo). Never commit customer art.
public/brand/*
!public/brand/mark.svg

# Local OWASP ZAP runtime (official Linux tarball / extracted tree). Never commit.
.zap-runtime/

__pycache__/
*.pyc
