# White-label name and mark. Copy to .env.local and restart the dev server.
# Does not change navy/gold chrome — that lives in tailwind.config.ts and globals.css.

# Company pack id (folder under org-logos/, then brands/). Empty = Scoping.
# Prefer this over NEXT_PUBLIC_BRAND_* so customer logos stay gitignored.
# Cloudflare: two paths in docs/cloudflare/intake.md — Admin deploy-only
# (NEXT_PUBLIC_BRAND_* at build time) vs runtime BRAND + R2/ASSETS.
BRAND=

NEXT_PUBLIC_BRAND_NAME=Scoping
NEXT_PUBLIC_PRODUCT_NAME=OSC Discovery
NEXT_PUBLIC_C3PAO_LEGAL_NAME=the C3PAO
NEXT_PUBLIC_BRAND_LOGO=/brand/mark.svg
NEXT_PUBLIC_PUBLIC_SITE_URL=/
NEXT_PUBLIC_ASSESSOR_MAILBOX=assessors@example.com
NEXT_PUBLIC_CONTACT_EMAIL=assessors@example.com

# --- Assessor gate (REQUIRED except on loopback) ---
# Locks /assessor, /drop/*/internal, and /api/submissions.
# Empty key fails closed unless Host is 127.0.0.1 / localhost / ::1.
# Sign in at /assessor/login (sets an HttpOnly SameSite=Strict cookie).
# APIs also accept header x-prescope-assessor-key. Do not put the key in the URL.
PSC_ASSESSOR_KEY=

# --- Box (Next.js local handoff; production writes go through the Worker) ---
# Thank-you CTA. Must point at 01 Answers + 02 Uploads only. Never 00 Internal.
PSC_BOX_CUSTOMER_LINK=
# Writes the answers markdown into 01 Answers after submit. Blank = skipped.
# Do not put Box secrets in NEXT_PUBLIC_* or the browser bundle.
PSC_BOX_ACCESS_TOKEN=
PSC_BOX_ANSWERS_FOLDER_ID=

# --- Cloudflare Worker (Next.js demo/intake path; see docs/cloudflare/README.md) ---
# Server-only feature flag. When PRESCOPE_SUBMIT_WORKER_URL is set, POST /api/submit
# forwards { answers } to Worker POST /submit after the in-process store write.
# Clear the URL for local/demo without a Worker. Power Automate F1–F2b stays the
# live Power Pages path — this flag does not touch Pages / Dataverse / flows.
# Public Worker origin (not a secret). Next never sends this to the browser.
# Production (prescope-intake Worker — technical service name; keep as-is):
# set these with `wrangler secret put`, not a committed file.
# Example placeholder: https://prescope-submit.<account>.workers.dev
# See docs/cloudflare/intake.md.
PRESCOPE_SUBMIT_WORKER_URL=
# Server-only placeholder. Same value as the Worker's wrangler secret
# (Authorization Bearer or X-Prescope-Fill-Key). Leave blank to skip the call
# even when the URL is set. Never NEXT_PUBLIC_*. Never put Box CCG secrets here.
PRESCOPE_SUBMIT_SECRET=
